{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar proyecto",
      "type": "process",
      "command": "javac",
      "args": [
        "-d",
        "${workspaceFolder}\\bin",
        "-sourcepath",
        "${workspaceFolder}\\ExamenED_Grupo4",
        "${workspaceFolder}\\ExamenED_Grupo4\\Main.java"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$javac"
    }
  ]
}
